{
  "name": "hpbuysell_adm_usermgmt",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/change-tracking": "^2.1.0",
    "@cap-js/postgres": "^2",
    "@sap-cloud-sdk/http-client": "^4.8.0",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "axios": "^1.19.0",
    "better-sqlite3": "^13.0.1",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-usermgmt.ui": "cds watch --open hpbuysell.adm.usermgmt.ui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy hpbuysell_adm_usermgmt --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/usermgmt.ui"
  ],
  "cds": {
    "requires": {
      "db": {
        "kind": "postgres",
        "credentials": {
          "schema": "hpbuysell_adm_usermgmt"
        }
      },
      "IAS_SCIM": {
        "kind": "rest",
        "credentials": {
          "destination": "IAS_SCIM"
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "destinations": true,
        "connectivity": true
      }
    }
  }
}
