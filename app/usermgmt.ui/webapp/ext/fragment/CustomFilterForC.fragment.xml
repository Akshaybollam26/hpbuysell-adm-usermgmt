<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <MultiInput
        id="CustomerFilterMultiInput"
        width="100%"
        showValueHelp="true"
        core:require="{handler: 'hpbuysell/adm/usermgmt/ui/ext/fragment/CustomFilterForC'}"
        valueHelpRequest="handler.onValueHelpRequest"
        tokenUpdate="handler.onTokenUpdate"
        liveChange="handler.onLiveChangeOfC"
        value="{
            path: 'filterValues>',
            type: 'sap.fe.macros.filter.type.Value',
            formatOptions: { operator: 'hpbuysell.adm.usermgmt.ui.ext.fragment.CustomFilterForC.filterItems' }
        }">
    </MultiInput>
</core:FragmentDefinition>