<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <MultiInput
        id="SupplierFilterMultiInput"
        width="100%"
        showValueHelp="true"
        core:require="{handler:'hpbuysell/adm/usermgmt/ui/ext/fragment/CustomFilterForS'}"
        valueHelpRequest="handler.onValueHelpRequest"
        liveChange="handler.onLiveChangeOfS"
        showSuggestion="true"
        suggestionRows="{commonServiceModel>/Supplier}"
		suggestionItemSelected="handler.onSuggItemSelForS"
        value="{
            path: 'filterValues>',
            type: 'sap.fe.macros.filter.type.Value',
            formatOptions: {
                operator: 'hpbuysell.adm.usermgmt.ui.ext.fragment.CustomFilterForS.filterItems'
            }
        }">
        <suggestionColumns>
			<Column
				hAlign="Begin"
				popinDisplay="Inline"
				demandPopin="true">
				<Label text="Supplier Id"/>
			</Column>
			<Column
				hAlign="Center"
				popinDisplay="Inline"
				demandPopin="true"
				minScreenWidth="Tablet">
				<Label text="Supplier Name"/>
			</Column>
		</suggestionColumns>
		<suggestionRows>
			<ColumnListItem>
			<cells>
				<Label text="{commonServiceModel>supplierid}"/>
				<Label text="{commonServiceModel>suppliername}"/>
			</cells>
			</ColumnListItem>
		</suggestionRows>
    </MultiInput>
</core:FragmentDefinition>