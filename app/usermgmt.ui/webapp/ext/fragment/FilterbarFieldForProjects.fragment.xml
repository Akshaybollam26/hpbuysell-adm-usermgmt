<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <MultiInput
        id="filterbarFieldForProjects"
        showValueHelp="true"
        core:require="{handler: 'hpbuysell/adm/usermgmt/ui/ext/fragment/SuppMngProjColumn'}"
        valueHelpRequest="handler.onVHRequestForProjects"
        tokenUpdate="handler.onTokenUpdate"
		suggestionItemSelected="handler.onSuggItemSelForProject"
        showSuggestion="true"
        suggestionRows="{commonServiceModel>/ProjectCompanyVH}"
        >
        <suggestionColumns>
			<Column
				hAlign="Begin"
				popinDisplay="Inline"
				demandPopin="true">
				<Label text="Project Id"/>
			</Column>
			<Column
				hAlign="Center"
				popinDisplay="Inline"
				demandPopin="true"
				minScreenWidth="Tablet">
				<Label text="Project Name"/>
			</Column>
		</suggestionColumns>
		<suggestionRows>
			<ColumnListItem>
			<cells>
				<Label text="{commonServiceModel>wbselement}"/>
				<Label text="{commonServiceModel>wbsdescription}"/>
			</cells>
			</ColumnListItem>
		</suggestionRows>
    </MultiInput>
</core:FragmentDefinition>
