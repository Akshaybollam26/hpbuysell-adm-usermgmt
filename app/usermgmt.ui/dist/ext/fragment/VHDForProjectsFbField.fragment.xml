<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m"  xmlns:vh="sap.ui.comp.valuehelpdialog" xmlns:fb="sap.ui.comp.filterbar">
    <vh:ValueHelpDialog id="vhdForProjectsFilter" title="Select Projects" supportMultiselect="true" key="projectId" descriptionKey="projectName" core:require="{ handler: 'hpbuysell/adm/usermgmt/ui/ext/fragment/SuppMngProjColumn' }"
        ok="handler.vhdForProjects_onOK" cancel="handler.vhdForProjects_onCancel" afterClose="handler.onVHDForProjects_AfterClose">
        <vh:filterBar>
            <fb:FilterBar id="VHDFilterBar" showGoOnFB="true" useToolbar="true" search="handler.onVHDForProjectFilter_Search">
                <fb:filterGroupItems>
                    <fb:FilterGroupItem groupName="__$INTERNAL$" name="projectId" label="Project Id" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="fb1"/>
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem groupName="__$INTERNAL$" name="projectName" label="Project Name" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="fb2"/>
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>
        </vh:filterBar>
    </vh:ValueHelpDialog>
</core:FragmentDefinition>
 